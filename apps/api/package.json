{
  "name": "@fleet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.promises.cp('src/db/schema.sql','dist/db/schema.sql'))\"",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "otplib": "^12.0.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
