{
  "expo": {
    "name": "Fleet",
    "slug": "fleet",
    "scheme": "fleet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fleet to attach vehicle appearance photos."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
