# Copy to apps/mobile/.env (gitignored) and set your machine's LAN IP.
# Expo loads EXPO_PUBLIC_* from this file when you run `npm run dev:mobile`.
# Restart Expo after changing values.
#
# Find IP (macOS): ipconfig getifaddr en0
# Physical device and some emulators cannot use localhost for the API on your laptop.

EXPO_PUBLIC_API_URL=http://192.168.1.x:3001
