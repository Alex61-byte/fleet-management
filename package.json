{
  "name": "fleet-management",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@fleet/api --filter=@fleet/web",
    "dev:api": "turbo run dev --filter=@fleet/api",
    "dev:web": "turbo run dev --filter=@fleet/web",
    "dev:mobile": "npm run start -w @fleet/mobile",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@fleet/api",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native": "0.86.0",
    "expo": "57.0.0",
    "@expo/metro-config": "57.0.2",
    "@expo/metro-runtime": "57.0.2",
    "babel-preset-expo": "57.0.1",
    "expo-router": "57.0.2"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
