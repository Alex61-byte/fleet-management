# Copy to `.env` at the repo root (or `apps/api/.env`) and fill in values.
# Never commit real credentials.

# Render Postgres — Dashboard → your Postgres → Connect
# Prefer the **External Database URL** when the API runs on your machine.
# Prefer the **Internal Database URL** when the API is also on Render (same region).
# Example external:
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/DATABASE
DATABASE_URL=

# Optional: force SSL (Render external already triggers SSL via host / sslmode=require)
# DATABASE_SSL=true

# Auth signing key (HS256). Required non-empty. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-long-random-string

# API listen port (Render sets PORT automatically)
# PORT=3001

# Driver invites — both RESEND_API_KEY and RESEND_FROM are required to send.
# Without RESEND_FROM the API uses NullMailer and invite_email_sent is always false.
# Dev sender: Fleet <onboarding@resend.dev> (Resend only delivers to your account email
# until you verify a domain, then set RESEND_FROM to an address on that domain).
RESEND_API_KEY=
RESEND_FROM=Fleet <onboarding@resend.dev>
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_MOBILE_INVITE_SCHEME=fleet
