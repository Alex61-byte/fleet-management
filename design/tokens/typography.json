{
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "system-ui", "SF Pro Text", "Roboto", "sans-serif"]
    },
    "tabular": {
      "$type": "fontFamily",
      "$value": ["Inter", "ui-sans-serif", "SF Pro Text", "Roboto", "sans-serif"],
      "$description": "Use with tabular-nums for counts, dates, TOTP digits"
    }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": "400" },
    "medium": { "$type": "fontWeight", "$value": "500" },
    "semibold": { "$type": "fontWeight", "$value": "600" },
    "bold": { "$type": "fontWeight", "$value": "700" }
  },
  "fontSize": {
    "overline": { "$type": "dimension", "$value": "11px", "$description": "Section kicker, table overline, KPI caption" },
    "caption": { "$type": "dimension", "$value": "12px" },
    "table": { "$type": "dimension", "$value": "13px", "$description": "Compact table cell / table header" },
    "label": { "$type": "dimension", "$value": "14px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "section": { "$type": "dimension", "$value": "16px", "$description": "Section title inside a page" },
    "title": { "$type": "dimension", "$value": "20px", "$description": "Page title (compact web) / mobile section" },
    "page": { "$type": "dimension", "$value": "24px", "$description": "Page title comfortable / web display" },
    "display": { "$type": "dimension", "$value": "32px", "$description": "KPI count, auth product mark companion" }
  },
  "lineHeight": {
    "overline": { "$type": "number", "$value": 1.3 },
    "caption": { "$type": "number", "$value": 1.35 },
    "table": { "$type": "number", "$value": 1.35 },
    "label": { "$type": "number", "$value": 1.4 },
    "body": { "$type": "number", "$value": 1.5 },
    "section": { "$type": "number", "$value": 1.35 },
    "title": { "$type": "number", "$value": 1.3 },
    "page": { "$type": "number", "$value": 1.25 },
    "display": { "$type": "number", "$value": 1.15 }
  },
  "letterSpacing": {
    "overline": { "$type": "dimension", "$value": "0.08em" },
    "tight": { "$type": "dimension", "$value": "-0.01em" },
    "normal": { "$type": "dimension", "$value": "0" },
    "wide": { "$type": "dimension", "$value": "0.12em", "$description": "TOTP digits" }
  }
}
