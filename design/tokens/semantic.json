        "size-public": { "$type": "dimension", "$value": "{spacing.mark-public}" },
        "size-public-width": { "$type": "dimension", "$value": "{spacing.mark-public-width}" },
        "$description": "Fleet registration plate SVG. Shielded: fill = shield + character blocks; glyph = keyline + plate face + left bolt; accent = country band. Public header (unshielded): plate-face enamel + fill edge/ink + accent band; no navy shield. Wrappers are size only — no bg-mark-fill."
      },
